PORT=4000
NODE_ENV=development

# Database Configuration (supports 'mysql' for Docker/Production and 'sqlite' for zero-config local dev)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=devinterview
DB_PASSWORD=devinterview_secret
DB_DATABASE=devinterview_db
SQLITE_DB_PATH=./data/devinterview.sqlite

# JWT Security
JWT_SECRET=devinterview_super_secure_jwt_secret_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=devinterview_refresh_secret_key_2026_very_secure_long_string
JWT_REFRESH_EXPIRES_IN=7d

# Redis (falls back to internal memory cache when unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sandboxed Execution (timeout in ms, memory in MB)
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_EXECUTION_MAX_MEMORY_MB=128

# Client URL for CORS
CLIENT_URL=http://localhost:5173
